#!/bin/bash

# fzf loader kept for compatibility: bashrc/zshrc and dot_profile source
# "components/fzf". The actual work lives in fzf_core (PATH, init, options,
# shared helpers) and fzf_tab_completion (TAB binding), so a shell with
# DOTFILES_ENABLE_FZF_TAB_COMPLETION=false never parses the latter.

# shellcheck source=/dev/null
case $- in
*i*) ;;
*) return ;;
esac

source ~/dotfiles/components/fzf_core

# fzf_core returns early when fzf is not installed, so the helper below only
# exists when it ran to the end.
if type dotfiles_fzf__flag_enabled >/dev/null 2>&1 &&
	dotfiles_fzf__flag_enabled DOTFILES_ENABLE_FZF_TAB_COMPLETION; then
	# shellcheck source=/dev/null
	source ~/dotfiles/components/fzf_tab_completion
fi
