#!/bin/bash

# OS / platform detection for dotfiles.
# Exports:
#   DOTFILES_OS: linux|darwin|unknown
#   DOTFILES_DISTRO_ID: e.g. debian|ubuntu|arch|unknown
#   DOTFILES_DISTRO_LIKE: value of ID_LIKE (may be empty)
#   DOTFILES_WSL: 1 if running under WSL, else 0
#   DOTFILES_WSL_VERSION: 1 or 2 under WSL, else 0
#   DOTFILES_CONTAINER: 1 if running in a container, else 0

DOTFILES_OS="unknown"
case "$(uname -s 2>/dev/null)" in
Linux) DOTFILES_OS="linux" ;;
Darwin) DOTFILES_OS="darwin" ;;
esac
export DOTFILES_OS

DOTFILES_DISTRO_ID="unknown"
DOTFILES_DISTRO_LIKE=""
if [[ -r /etc/os-release ]]; then
	# Source in a subshell so os-release variables (NAME, VERSION, PRETTY_NAME, ...)
	# do not leak into the interactive shell.
	# shellcheck source=/dev/null
	_dotfiles_osrel=$(. /etc/os-release 2>/dev/null && printf '%s\n%s' "${ID:-}" "${ID_LIKE:-}")
	[[ -n "${_dotfiles_osrel%%$'\n'*}" ]] && DOTFILES_DISTRO_ID="${_dotfiles_osrel%%$'\n'*}"
	DOTFILES_DISTRO_LIKE="${_dotfiles_osrel#*$'\n'}"
	unset _dotfiles_osrel
fi
export DOTFILES_DISTRO_ID
export DOTFILES_DISTRO_LIKE

DOTFILES_WSL=0
if [[ -n "${WSL_INTEROP:-}" || -n "${WSL_DISTRO_NAME:-}" ]]; then
	DOTFILES_WSL=1
elif [[ -r /proc/version ]] && grep -qiE 'microsoft|wsl' /proc/version; then
	DOTFILES_WSL=1
fi
export DOTFILES_WSL

# 0 when not under WSL, otherwise 1 or 2.
# WSL2 runs a real Linux kernel and marks it in the kernel release / /proc/version;
# only WSL2 provides the /run/WSL interop socket directory.
DOTFILES_WSL_VERSION=0
if [[ "${DOTFILES_WSL}" == "1" ]]; then
	DOTFILES_WSL_VERSION=1
	if [[ "$(uname -r 2>/dev/null)" == *[Ww][Ss][Ll]2* ]]; then
		DOTFILES_WSL_VERSION=2
	elif [[ -d /run/WSL ]]; then
		DOTFILES_WSL_VERSION=2
	elif [[ -r /proc/version ]] && grep -qi 'wsl2' /proc/version; then
		DOTFILES_WSL_VERSION=2
	fi
fi
export DOTFILES_WSL_VERSION

DOTFILES_CONTAINER=0
if [[ -f /.dockerenv || -f /run/.containerenv ]]; then
	DOTFILES_CONTAINER=1
elif [[ -r /proc/1/cgroup ]] && grep -qE '(docker|lxc|kubepods|containerd)' /proc/1/cgroup; then
	DOTFILES_CONTAINER=1
fi
export DOTFILES_CONTAINER

dotfiles_is_wsl() { [[ "${DOTFILES_WSL}" == "1" ]]; }
dotfiles_is_wsl1() { [[ "${DOTFILES_WSL_VERSION}" == "1" ]]; }
dotfiles_is_wsl2() { [[ "${DOTFILES_WSL_VERSION}" == "2" ]]; }
dotfiles_is_container() { [[ "${DOTFILES_CONTAINER}" == "1" ]]; }
dotfiles_is_linux() { [[ "${DOTFILES_OS}" == "linux" ]]; }
dotfiles_is_darwin() { [[ "${DOTFILES_OS}" == "darwin" ]]; }
dotfiles_is_debian_like() { [[ "${DOTFILES_DISTRO_ID}" == "debian" || "${DOTFILES_DISTRO_ID}" == "ubuntu" || "${DOTFILES_DISTRO_LIKE}" == *debian* ]]; }

