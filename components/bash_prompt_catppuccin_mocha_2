#!/bin/bash
# Catppuccin Mocha bash prompt - Variant 5 (muted: subtext/overlay tones)
# https://catppuccin.com/palette

_CAT_ROSEWATER="\e[38;2;245;224;220m"
_CAT_FLAMINGO="\e[38;2;242;205;205m"
_CAT_PINK="\e[38;2;245;194;231m"
_CAT_MAUVE="\e[38;2;203;166;247m"
_CAT_RED="\e[38;2;243;139;168m"
_CAT_MAROON="\e[38;2;235;160;172m"
_CAT_PEACH="\e[38;2;250;179;135m"
_CAT_YELLOW="\e[38;2;249;226;175m"
_CAT_GREEN="\e[38;2;166;227;161m"
_CAT_TEAL="\e[38;2;148;226;213m"
_CAT_SKY="\e[38;2;137;220;235m"
_CAT_SAPPHIRE="\e[38;2;116;199;236m"
_CAT_BLUE="\e[38;2;137;180;250m"
_CAT_LAVENDER="\e[38;2;180;190;254m"
_CAT_TEXT="\e[38;2;205;214;244m"
_CAT_SUBTEXT1="\e[38;2;186;194;222m"
_CAT_SUBTEXT0="\e[38;2;166;173;200m"
_CAT_OVERLAY2="\e[38;2;147;153;178m"
_CAT_OVERLAY1="\e[38;2;127;132;156m"

# Muted color assignments — accent only on user/host/git, rest subdued
COLOR_BRACKET=${_CAT_OVERLAY1}
COLOR_DIR=${_CAT_SUBTEXT1}
COLOR_SEPARATOR=${_CAT_OVERLAY2}
COLOR_DATE=${_CAT_OVERLAY2}
COLOR_GIT_BRANCH=${_CAT_MAUVE}
COLOR_SUDO_ACTIVE=${_CAT_PEACH}
COLOR_SSH_ACTIVE=${_CAT_SAPPHIRE}

if [[ ${EUID} -ne 0 ]]; then
	COLOR_USER=${_CAT_LAVENDER}
	COLOR_HOST=${_CAT_SUBTEXT0}
	COLOR_SYMBOL=${_CAT_SUBTEXT1}
	USER_HOST_SEP='🤘'
else
	COLOR_USER=${_CAT_RED}
	COLOR_HOST=${_CAT_MAROON}
	COLOR_SYMBOL=${_CAT_RED}
	USER_HOST_SEP='💀'
fi

SYMBOL="\\$"

DOTFILES_GET_PRIMARY_IP() {
	if command -v dotfiles_is_darwin >/dev/null 2>&1 && dotfiles_is_darwin; then
		local ip=""
		if command -v ipconfig >/dev/null 2>&1; then
			ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)"
		fi
		if [[ -z ${ip} ]] && command -v ifconfig >/dev/null 2>&1; then
			ip="$(ifconfig 2>/dev/null | awk '/inet / {print $2}' | grep -v '^127\.' | grep -v '^169\.254\.' | head -n 1 || true)"
		fi
		printf '%s' "${ip}"
		return 0
	fi

	if command -v ip >/dev/null 2>&1; then
		ip -4 a 2>/dev/null | grep 'inet' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '^127\.' | grep -v '^169\.254\.' | grep -v '^172\.' | grep -v '^100\.' | head -n 1 || true
	elif command -v hostname >/dev/null 2>&1; then
		hostname -I 2>/dev/null | tr ' ' '\n' | grep -Eo '([0-9]*\.){3}[0-9]*' | grep -v '^127\.' | grep -v '^169\.254\.' | grep -v '^172\.' | grep -v '^100\.' | head -n 1 || true
	fi
}

IP="$(DOTFILES_GET_PRIMARY_IP)"

function COLOR_EXIT_STATUS() {
	if [[ $1 -eq 0 ]]; then
		printf '%s' "${_CAT_OVERLAY2}"
	else
		printf '%s' "${_CAT_RED}"
	fi
}

function CHECK_IF_GIT_REPO() {
	git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

function GIT_PROMPT() {
	if ! command -v git >/dev/null 2>&1; then
		return 0
	fi
	if ! type __git_ps1 >/dev/null 2>&1; then
		return 0
	fi

	export GIT_PS1_DESCRIBE_STYLE='contains'
	export GIT_PS1_SHOWCOLORHINTS='n'
	export GIT_PS1_SHOWDIRTYSTATE='y'
	export GIT_PS1_SHOWSTASHSTATE='y'
	export GIT_PS1_SHOWUNTRACKEDFILES='y'
	export GIT_PS1_SHOWUPSTREAM='auto'

	__git_ps1 'git:%s'
}

function CHECK_IF_SUDO_IS_ACTIVE() {
	if [[ ${EUID} -eq 0 ]]; then
		return 1
	else
		if sudo -vn 2>/dev/null; then
			return 0
		else
			return 1
		fi
	fi
}

function CHECK_IF_SSH_SESSION() {
	if [[ -n ${SSH_CONNECTION} || -n ${SSH_CLIENT} ]]; then
		return 0
	else
		return 1
	fi
}

function SHOW_PERMISSIONS_OF_CUR_DIR() {
	if command -v dotfiles_is_darwin >/dev/null 2>&1 && dotfiles_is_darwin; then
		stat -f %Lp . 2>/dev/null || true
	else
		stat -c %a . 2>/dev/null || true
	fi
}

function BUILD_PROMPT() {
	local exit_status=$?
	local git_part
	local prompt_style="${DOTFILES_PROMPT_STYLE:-classic}"

	if [[ -z ${DOTFILES_STDIN_FLUSHED+x} ]]; then
		DOTFILES_STDIN_FLUSHED=1
		local _dotfiles_steps=4
		local _dotfiles_step_wait=0.05
		if [[ -n ${BASH_VERSINFO[0]:-} && ${BASH_VERSINFO[0]} -lt 4 ]]; then
			_dotfiles_step_wait=1
		fi
		[[ -n "${TMUX:-}" ]] && _dotfiles_steps=80

		local _dotfiles_i=0
		local _dotfiles_step=0
		for ((_dotfiles_step = 0; _dotfiles_step < _dotfiles_steps; _dotfiles_step++)); do
			local _dotfiles_drained=0
			while IFS= read -r -t 0 -n 1 _dotfiles_discard; do
				_dotfiles_drained=1
				((_dotfiles_i++ > 2048)) && break
			done

			if IFS= read -r -t "${_dotfiles_step_wait}" -n 1 _dotfiles_discard; then
				_dotfiles_drained=1
				continue
			fi
			[[ "${_dotfiles_drained}" -eq 1 ]] || break
		done
	fi

	if [[ ${prompt_style} == "compact" ]]; then
		BASH_PROMPT="\n"
		BASH_PROMPT+="\[$(COLOR_EXIT_STATUS "${exit_status}")\]┌──"
		BASH_PROMPT+="\[$COLOR_BRACKET\]("
		BASH_PROMPT+="\[$COLOR_USER\]\\u"
		BASH_PROMPT+="\[$COLOR_SEPARATOR\]${USER_HOST_SEP}"
		BASH_PROMPT+="\[$COLOR_HOST\]\\h"
		BASH_PROMPT+="\[$COLOR_BRACKET\])-["
		BASH_PROMPT+="\[$COLOR_DIR\]\\w"
		BASH_PROMPT+="\[$COLOR_BRACKET\]]"
	else
		BASH_PROMPT="\n"
		BASH_PROMPT+="\[$(COLOR_EXIT_STATUS "${exit_status}")\]┌"
		BASH_PROMPT+="\[$COLOR_BRACKET\]["
		BASH_PROMPT+="\[$COLOR_DATE\]\\t"
		BASH_PROMPT+="\[$COLOR_BRACKET\]]"
		BASH_PROMPT+=" "
		BASH_PROMPT+="\[$COLOR_BRACKET\]["

		if CHECK_IF_SSH_SESSION; then
			BASH_PROMPT+="\[$COLOR_SSH_ACTIVE\]ssh\[$COLOR_SEPARATOR\]:"
		fi

		BASH_PROMPT+="\[$COLOR_USER\]\\u\[$COLOR_SEPARATOR\]${USER_HOST_SEP}\[$COLOR_HOST\]\\h"
		if [[ -n ${IP} ]]; then
			BASH_PROMPT+="\[$COLOR_SEPARATOR\] (\[$COLOR_RESET\]${IP}\[$COLOR_SEPARATOR\])"
		fi
		BASH_PROMPT+="\[$COLOR_SEPARATOR\]: "
		BASH_PROMPT+="\[$COLOR_DIR\]\\w"
		BASH_PROMPT+="\[$COLOR_RESET\] ($(SHOW_PERMISSIONS_OF_CUR_DIR))"
		BASH_PROMPT+="\[$COLOR_BRACKET\]]"
	fi

	if CHECK_IF_GIT_REPO; then
		git_part="$(GIT_PROMPT)"
		if [[ -n ${git_part} ]]; then
			local git_body="$git_part"
			local git_upstream=""
			case "$git_part" in
				*"<>" )
					git_body="${git_part%<>}"
					git_upstream="<>"
					;;
				*">" )
					git_body="${git_part%>}"
					git_upstream=">"
					;;
				*"<" )
					git_body="${git_part%<}"
					git_upstream="<"
					;;
				*"=" )
					git_body="${git_part%=}"
					git_upstream="="
					;;
			esac

			BASH_PROMPT+=" "
			BASH_PROMPT+="\[$COLOR_BRACKET\]["
			BASH_PROMPT+="\[$COLOR_GIT_BRANCH\]${git_body}"
			if [[ -n ${git_upstream} ]]; then
				BASH_PROMPT+="\[${_CAT_OVERLAY2}\]${git_upstream}"
			fi
			BASH_PROMPT+="\[$COLOR_BRACKET\]]"
		fi
	fi

	if CHECK_IF_SUDO_IS_ACTIVE; then
		BASH_PROMPT+=" "
		BASH_PROMPT+="\[$COLOR_BRACKET\]["
		BASH_PROMPT+="\[$COLOR_SUDO_ACTIVE\]sudo"
		BASH_PROMPT+="\[$COLOR_BRACKET\]]"
	fi

	BASH_PROMPT+="\n"
	BASH_PROMPT+="\[$(COLOR_EXIT_STATUS "${exit_status}")\]└─"
	BASH_PROMPT+="\[$COLOR_SYMBOL\]${SYMBOL} "
	BASH_PROMPT+="\[$COLOR_RESET\]"

	PS1=${BASH_PROMPT}
}

case ";${PROMPT_COMMAND};" in
*";BUILD_PROMPT;"* | *"; BUILD_PROMPT;"*) ;;
*)
	if [[ -n ${PROMPT_COMMAND} ]]; then
		PROMPT_COMMAND="${PROMPT_COMMAND}; BUILD_PROMPT"
	else
		PROMPT_COMMAND="BUILD_PROMPT"
	fi
	;;
esac

export PROMPT_COMMAND
