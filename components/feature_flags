#!/bin/bash

# Feature flags for dotfiles (opt-in overrides via local settings).
#
# Local overrides (gitignored):
#   ~/dotfiles/config/local_dotfiles_settings
#
# Example:
#   DOTFILES_ENABLE_FZF=false
#   DOTFILES_ENABLE_TMUX_AUTOSTART=false
#   DOTFILES_ENABLE_AUTOUPDATE=false

dotfiles_flag_enabled() {
	local var_name="$1"
	local value=""
	eval "value=\"\${${var_name}:-}\""
	case "${value}" in
	1 | true | TRUE | yes | YES | y | Y | on | ON) return 0 ;;
	0 | false | FALSE | no | NO | n | N | off | OFF | "") return 1 ;;
	*) return 1 ;;
	esac
}

if [[ -f "${HOME}/dotfiles/config/local_dotfiles_settings" ]]; then
	# shellcheck source=/dev/null
	source "${HOME}/dotfiles/config/local_dotfiles_settings"
fi

: "${DOTFILES_ENABLE_PROMPT:=true}"
: "${DOTFILES_ENABLE_BASH_COMPLETION:=true}"
: "${DOTFILES_ENABLE_FZF:=true}"
: "${DOTFILES_ENABLE_NAVI:=true}"
: "${DOTFILES_ENABLE_ALIASES:=true}"
: "${DOTFILES_ENABLE_SSH_PICKER:=true}"
: "${DOTFILES_ENABLE_GIT_FZF:=true}"
: "${DOTFILES_ENABLE_FZF_EXTRAS:=true}"
: "${DOTFILES_ENABLE_FZF_HISTORY_BINDINGS:=true}"
: "${DOTFILES_ENABLE_FZF_CDF_BINDING:=true}"
: "${DOTFILES_ENABLE_HELPERS:=true}"
: "${DOTFILES_ENABLE_FZF_TAB_COMPLETION:=true}"
: "${DOTFILES_ENABLE_EXTRACT_EXT:=true}"
: "${DOTFILES_ENABLE_BREW:=true}"
: "${DOTFILES_ENABLE_OH_MY_ZSH:=false}"
: "${DOTFILES_ENABLE_MOTD:=false}"
: "${DOTFILES_ENABLE_MOTD_AUTO_RUN:=false}"
: "${DOTFILES_ENABLE_AUTOUPDATE:=true}"
: "${DOTFILES_ENABLE_TMUX_AUTOSTART:=true}"
: "${DOTFILES_ENABLE_SSH_TMUX_RENAME:=true}"
: "${DOTFILES_ENABLE_TMUX_FZF:=true}"
: "${DOTFILES_ENABLE_JOURNALCTL_PICKER:=true}"
# LOG_PICKER: macOS log picker (lctl) - default enabled on macOS only
if [[ "${DOTFILES_OS:-}" == "darwin" ]]; then
	: "${DOTFILES_ENABLE_LOG_PICKER:=true}"
else
	: "${DOTFILES_ENABLE_LOG_PICKER:=false}"
fi
: "${DOTFILES_ENABLE_SYSTEMCTL_FZF:=true}"
: "${DOTFILES_ENABLE_DOT_DOCTOR:=true}"
: "${DOTFILES_ENABLE_LAZY_LOADING:=true}"
: "${DOTFILES_ENABLE_DOCKER_FZF:=true}"
: "${DOTFILES_ENABLE_DOT_HELP:=true}"
: "${DOTFILES_ENABLE_DOT_HELP_BINDING:=true}"
: "${DOTFILES_ENABLE_RELOAD_BINDING:=true}"
: "${DOTFILES_ENABLE_IOBROKER:=true}"
: "${DOTFILES_ENABLE_MOTD_WIDGETS:=true}"
# Network reachability widget: opt-in, needs config/network-hosts.conf
: "${DOTFILES_ENABLE_NETWORK_WIDGET:=false}"
# MOTD style: "tree" (tree layout), "default" (simple key-value lines)
: "${DOTFILES_MOTD_STYLE:=tree}"

# Cache: normalize every flag to a canonical true/false exactly once here,
# so the 30+ startup checks in bashrc/zshrc can do a plain string comparison
# instead of invoking dotfiles_flag_enabled (eval + case) on every check.
_dotfiles_flag_names=(
	DOTFILES_ENABLE_PROMPT
	DOTFILES_ENABLE_BASH_COMPLETION
	DOTFILES_ENABLE_FZF
	DOTFILES_ENABLE_NAVI
	DOTFILES_ENABLE_ALIASES
	DOTFILES_ENABLE_SSH_PICKER
	DOTFILES_ENABLE_GIT_FZF
	DOTFILES_ENABLE_FZF_EXTRAS
	DOTFILES_ENABLE_FZF_HISTORY_BINDINGS
	DOTFILES_ENABLE_FZF_CDF_BINDING
	DOTFILES_ENABLE_HELPERS
	DOTFILES_ENABLE_FZF_TAB_COMPLETION
	DOTFILES_ENABLE_EXTRACT_EXT
	DOTFILES_ENABLE_BREW
	DOTFILES_ENABLE_OH_MY_ZSH
	DOTFILES_ENABLE_MOTD
	DOTFILES_ENABLE_MOTD_AUTO_RUN
	DOTFILES_ENABLE_AUTOUPDATE
	DOTFILES_ENABLE_TMUX_AUTOSTART
	DOTFILES_ENABLE_SSH_TMUX_RENAME
	DOTFILES_ENABLE_TMUX_FZF
	DOTFILES_ENABLE_JOURNALCTL_PICKER
	DOTFILES_ENABLE_LOG_PICKER
	DOTFILES_ENABLE_SYSTEMCTL_FZF
	DOTFILES_ENABLE_DOT_DOCTOR
	DOTFILES_ENABLE_LAZY_LOADING
	DOTFILES_ENABLE_DOCKER_FZF
	DOTFILES_ENABLE_DOT_HELP
	DOTFILES_ENABLE_DOT_HELP_BINDING
	DOTFILES_ENABLE_RELOAD_BINDING
	DOTFILES_ENABLE_IOBROKER
	DOTFILES_ENABLE_MOTD_WIDGETS
	DOTFILES_ENABLE_NETWORK_WIDGET
)
for _dotfiles_flag_name in "${_dotfiles_flag_names[@]}"; do
	if dotfiles_flag_enabled "${_dotfiles_flag_name}"; then
		eval "${_dotfiles_flag_name}=true"
	else
		eval "${_dotfiles_flag_name}=false"
	fi
done
unset _dotfiles_flag_name _dotfiles_flag_names

export DOTFILES_ENABLE_PROMPT
export DOTFILES_ENABLE_BASH_COMPLETION
export DOTFILES_ENABLE_FZF
export DOTFILES_ENABLE_NAVI
export DOTFILES_ENABLE_ALIASES
export DOTFILES_ENABLE_SSH_PICKER
export DOTFILES_ENABLE_GIT_FZF
export DOTFILES_ENABLE_FZF_EXTRAS
export DOTFILES_ENABLE_FZF_HISTORY_BINDINGS
export DOTFILES_ENABLE_FZF_CDF_BINDING
export DOTFILES_ENABLE_HELPERS
export DOTFILES_ENABLE_FZF_TAB_COMPLETION
export DOTFILES_ENABLE_EXTRACT_EXT
export DOTFILES_ENABLE_BREW
export DOTFILES_ENABLE_OH_MY_ZSH
export DOTFILES_ENABLE_MOTD
export DOTFILES_ENABLE_MOTD_AUTO_RUN
export DOTFILES_ENABLE_AUTOUPDATE
export DOTFILES_ENABLE_TMUX_AUTOSTART
export DOTFILES_ENABLE_SSH_TMUX_RENAME
export DOTFILES_ENABLE_TMUX_FZF
export DOTFILES_ENABLE_JOURNALCTL_PICKER
export DOTFILES_ENABLE_LOG_PICKER
export DOTFILES_ENABLE_SYSTEMCTL_FZF
export DOTFILES_ENABLE_DOT_DOCTOR
export DOTFILES_ENABLE_LAZY_LOADING
export DOTFILES_ENABLE_DOCKER_FZF
export DOTFILES_ENABLE_DOT_HELP
export DOTFILES_ENABLE_DOT_HELP_BINDING
export DOTFILES_ENABLE_RELOAD_BINDING
export DOTFILES_ENABLE_IOBROKER
export DOTFILES_ENABLE_MOTD_WIDGETS
export DOTFILES_ENABLE_NETWORK_WIDGET
export DOTFILES_MOTD_STYLE
