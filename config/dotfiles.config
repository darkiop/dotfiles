#!/bin/bash

export MOTD_SHOW_APT_UPDATES=y

# Prompt style: "classic" (default) or "compact"
# classic: Full info with ┌ and └─
# compact: Minimal info with ┌── and └─
export DOTFILES_PROMPT_STYLE="classic"

# Catppuccin palette as raw escape bytes (CAT_*), shared with the MOTD.
# shellcheck source=catppuccin.sh
source ~/dotfiles/config/catppuccin.sh

# The generic COLOR_* names every component prints with (echo -e / printf '%b'),
# mapped onto the catppuccin palette above so `dot doctor`, `dot help`,
# install.sh and the MOTD all render the same green.
export COLOR_BLUE="${CAT_SKY}"
export COLOR_LIGHT_BLUE="${CAT_TEAL}"
export COLOR_RED="${CAT_RED}"
export COLOR_GREEN="${CAT_GREEN}"
export COLOR_GREEN_BOLD=$'\x1b[1m'"${CAT_GREEN}"
export COLOR_YELLOW="${CAT_YELLOW}"
export COLOR_WHITE="${CAT_TEXT}"
export COLOR_ORANGE="${CAT_PEACH}"
export COLOR_PURPLE="${CAT_MAUVE}"
export COLOR_CLOSE="$(tput sgr0 2>/dev/null || true)"
export COLOR_RESET="\033[m"