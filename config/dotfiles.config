#!/bin/bash

export MOTD_SHOW_APT_UPDATES=y

# Prompt style: "classic" (default) or "compact"
# classic: Full info with ┌ and └─
# compact: Minimal info with ┌── and └─
export DOTFILES_PROMPT_STYLE="classic"

# Catppuccin palette as raw escape bytes (CAT_*), shared with the MOTD.
# shellcheck source=catppuccin.sh
source ~/dotfiles/config/catppuccin.sh

export COLOR_BLUE="\e[38;5;39m"
export COLOR_LIGHT_BLUE="\e[38;5;81m"
export COLOR_RED="\e[38;5;196m"
export COLOR_GREEN="\e[38;5;83m"
export COLOR_GREEN_BOLD="\e[1;38;5;83m"
export COLOR_YELLOW="\e[38;5;227m"
export COLOR_WHITE="\e[37m"
export COLOR_ORANGE="\e[38;5;214m"
export COLOR_PURPLE="\e[38;5;99m"
export COLOR_CLOSE="$(tput sgr0 2>/dev/null || true)"
export COLOR_RESET="\033[m"